# ============================================================
# Campus Resource Booking System - Environment Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# -- Server & Origin ------------------------------------------
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# -- PostgreSQL Database --------------------------------------
DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/campus_booking_dev
MIGRATION_DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/campus_booking_dev
TEST_DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/campus_booking_test

# -- Authentication & Session Security ------------------------
SESSION_SECRET=generate_a_64_char_random_string_here

# -- Seed Admin Credentials -----------------------------------
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=your_secure_admin_password

# -- SMTP / Email Credentials ---------------------------------
# Get Gmail App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM_NAME="Campus Resource Booking"
MAIL_FROM_ADDRESS=your_email@gmail.com

# -- Cron Job & QR Code Token Security -----------------------
REMINDER_CRON_INTERVAL="*/5 * * * *"
CHECKIN_TOKEN_SECRET=generate_a_64_char_random_string_here
